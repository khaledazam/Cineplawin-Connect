// =============================================================================
// Wassel (واصل) v1: Prisma schema (Production Master)
//
// Conventions
//  * Every tenant-owned model carries tenantId (NOT NULL) and, where it is the
//    target of a foreign key, @@unique([tenantId, id]) so children use composite
//    FKs (tenantId, parentId): a row can never point at another tenant's parent.
//  * By design WITHOUT tenantId: Tenant, PlatformAdmin, PlatformAdminSession.
//    AuditEvent.tenantId is nullable (platform-level events).
//  * Physical names are Prisma defaults (PascalCase tables, camelCase columns).
//    Raw SQL must quote identifiers, e.g. "Report"."tenantId".
//  * Constraints Prisma cannot express (CHECKs, partial indexes, triggers,
//    grants) live in constraints-and-roles.sql and are appended to the first
//    migration.
//  * Ids are generated by Prisma (uuid v4); raw SQL inserts must supply ids.
//  * NOT YET RUN through `prisma validate` (Prisma was unavailable when this was
//    written). First step: `prisma format && prisma validate`.
//  * Prisma 7+: connection URLs move to prisma.config.ts; adapt accordingly.
// =============================================================================

// -----------------------------------------------------------------------------
// // CHANGED: Item 8 & 11 - Application Contract & Code-Level Rules
// -----------------------------------------------------------------------------
// 1. Optimistic Concurrency on Report:
//    `Report.version` must be incremented by the application using:
//      `prisma.report.updateMany({ where: { id, tenantId, version }, data: { version: { increment: 1 }, ... } })`
//    The caller must assert that affected count === 1; if 0, throw a 409 Conflict.
//    Raw SQL updates do not automatically touch Prisma's `@updatedAt`.
//
// 2. Prisma Client with Composite Foreign Keys:
//    Always supply scalar (Unchecked) inputs (e.g. `tenantId`, `contactId`, `categoryId`)
//    when writing records. Do not use nested `connect: { ... }` on composite relations,
//    as Prisma Client can produce ambiguous queries or require non-composite targets.
//
// 3. Track-Report Lookups (Privacy Protection):
//    Citizen tracking queries must strictly match `Report.contactId` to the inbound
//    message sender's `Contact.id`. If a report matching the tracking code exists but
//    belongs to a different contact, the system MUST return the generic "not found"
//    response to prevent report enumeration and snooping.
//
// 4. Notification Routing:
//    Citizen outbound notifications are sent to the conversation of the originating
//    draft: Report -> ReportDraft -> Conversation -> Chatwoot conversation.
//
// 5. Generic Email Collision Errors:
//    Because `User.email` is globally unique across the entire platform, registration
//    and user invitation endpoints MUST return a generic error (e.g., "Unable to process
//    invitation / registration") rather than explicitly stating "email already in use",
//    preventing cross-tenant employee enumeration.
// -----------------------------------------------------------------------------

// -----------------------------------------------------------------------------
// // CHANGED: Item 9 - Data Retention Policies
// Proposed default retention windows (to be agreed with the pilot organization):
//  - InboxMessage.normalized: 14 days after `processedAt`. Strips raw inbound
//    payloads to minimize PII surface while leaving ample time for webhook debugging.
//  - ReportDraft (expired/cancelled): 7 days after `expiresAt` or status change.
//    Pruned by periodic background cleanup job.
//  - Report.description & Attachment files: Retained in hot storage for 180 days (6 months)
//    after `resolvedAt`. After 180 days, media attachments in S3/MinIO are deleted,
//    while report summary metadata remains for civic trend and SLA analysis.
//  - Notification rows: 30 days after `sentAt` or terminal failure (sufficient for
//    delivery audit trail).
//  - UserSession rows: 30 days after `expiresAt` or `revokedAt`.
// -----------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")         // cc_app: runtime role (non-owner)
  directUrl         = env("DATABASE_MIGRATE_URL") // cc_owner: used by `prisma migrate` only
  // CHANGED: Item 1 - Added shadow database for `prisma migrate dev` because cc_owner is NOCREATEDB.
  // Note: Production environments use `prisma migrate deploy` only (no shadow DB required).
  shadowDatabaseUrl = env("DATABASE_SHADOW_URL")
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum TenantStatus {
  DISABLED
  ACTIVE
  SUSPENDED
}

enum ChannelStatus {
  PENDING_VERIFICATION
  VERIFIED
  DISABLED
}

// SUPER_ADMIN is deliberately absent: platform operators live in PlatformAdmin.
enum UserRole {
  TENANT_ADMIN
  AGENT
}

// // CHANGED: Item 10 - Reconciled ReportStatus Enum with Part 1 & 2 UX Table
// Status Mapping Table:
// +-------------+-----------------------+-------+-------------------+-------------------------------------------------------------+
// | Internal    | Citizen Arabic Label  | Emoji | Notification Sent | Notification Type & Rules                                   |
// +-------------+-----------------------+-------+-------------------+-------------------------------------------------------------+
// | NEW         | جديد                  | 🔴    | Yes               | REPORT_CONFIRMATION sent immediately upon submission        |
// | IN_REVIEW   | قيد المراجعة          | 🟠    | No (by default)   | Internal triage; citizen notified only if tenant configured |
// | IN_PROGRESS | جاري العمل            | 🔵    | Yes               | STATUS_UPDATE sent upon assignment or field dispatch        |
// | RESOLVED    | تم الحل               | 🟢    | Yes               | RESOLUTION_UPDATE sent with closing note                    |
// | REJECTED    | مرفوض                 | ⚫    | Yes               | STATUS_UPDATE sent with citizenMessage (rejection reason)   |
// +-------------+-----------------------+-------+-------------------+-------------------------------------------------------------+
// (All 5 values match Part 1/Part 2 definitions; no enum rename needed).
enum ReportStatus {
  NEW
  IN_REVIEW
  IN_PROGRESS
  RESOLVED
  REJECTED
}

// Part 1's COMPLETED / CANCELLED / EXPIRED are DraftStatus outcomes; the
// conversation returns to IDLE afterwards.
enum BotState {
  IDLE
  AWAITING_CATEGORY
  AWAITING_DESCRIPTION
  AWAITING_PHOTO
  AWAITING_LOCATION
  AWAITING_CONFIRMATION
  AWAITING_TRACKING_CODE
  PROCESSING_MEDIA
  HANDOFF
}

enum DraftStatus {
  ACTIVE
  SUBMITTED
  CANCELLED
  EXPIRED
}

enum AttachmentStatus {
  PENDING
  STORED
  FAILED
  PURGED
}

enum ReportEventType {
  CREATED
  STATUS_CHANGED
  ASSIGNED
  NOTE_ADDED
}

// Shared by ReportEvent (CITIZEN, USER, SYSTEM) and AuditEvent (USER, PLATFORM_ADMIN, SYSTEM).
enum ActorType {
  CITIZEN
  USER
  PLATFORM_ADMIN
  SYSTEM
}

enum EventVisibility {
  PUBLIC
  INTERNAL
}

enum NotificationType {
  REPORT_CONFIRMATION
  STATUS_UPDATE
  RESOLUTION_UPDATE
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  FAILED_POLICY
  CANCELLED
}

enum InboxStatus {
  RECEIVED
  PROCESSED
  FAILED
}

// ----------------------------------------------------------------------------
// Registry: tenants and channels
// ----------------------------------------------------------------------------

model Tenant {
  id                String       @id @default(uuid()) @db.Uuid
  slug              String       @unique
  name              String
  status            TenantStatus @default(DISABLED)
  trackingPrefix    String       @db.VarChar(4)
  timezone          String       @default("Africa/Cairo")
  overdueAfterHours Int          @default(72) // initial setting, not a validated threshold
  draftTtlMinutes   Int          @default(30)
  // Zod-validated at the app layer. Keys: workingHours, directory, privacyPolicyUrl,
  // notifyOnStatuses, rateLimits.
  settings          Json         @default("{}")
  activatedAt       DateTime?    @db.Timestamptz(3)
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(3)

  channels      TenantChannel[]
  users         User[]
  userSessions  UserSession[]
  categories    Category[]
  contacts      Contact[]
  conversations Conversation[]
  drafts        ReportDraft[]
  attachments   Attachment[]
  reports       Report[]
  reportEvents  ReportEvent[]
  notifications Notification[]
  inboxMessages InboxMessage[]
  auditEvents   AuditEvent[]
}

model TenantChannel {
  id                String        @id @default(uuid()) @db.Uuid
  tenantId          String        @db.Uuid
  chatwootAccountId Int
  chatwootInboxId   Int
  botTokenEnc       Bytes // AES-256-GCM envelope; key kept outside the database
  webhookSecretHash String // SHA-256 of the per-channel path secret
  status            ChannelStatus @default(PENDING_VERIFICATION)
  verifiedAt        DateTime?     @db.Timestamptz(3)
  lastWebhookAt     DateTime?     @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  // Deliberately GLOBAL: webhook payload (account, inbox) resolves to exactly one tenant.
  @@unique([chatwootAccountId, chatwootInboxId])
  @@index([tenantId])
}

// ----------------------------------------------------------------------------
// Identity: tenant staff and platform operators
// ----------------------------------------------------------------------------

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @db.Uuid
  email              String    @unique // lowercased; globally unique so login needs no tenant
  passwordHash       String // argon2id
  displayName        String
  role               UserRole
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  failedLogins       Int       @default(0)
  lockedUntil        DateTime? @db.Timestamptz(3)
  lastLoginAt        DateTime? @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)

  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sessions        UserSession[]
  assignedReports Report[]
  reportEvents    ReportEvent[]

  @@unique([tenantId, id])
  @@index([tenantId, role, isActive])
}

model UserSession {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  userId    String    @db.Uuid
  familyId  String    @db.Uuid // rotation chain; reuse of a rotated token revokes the family
  tokenHash String    @unique // SHA-256 of the opaque refresh token
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, userId])
  @@index([familyId])
}

model PlatformAdmin {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String
  isActive     Boolean   @default(true)
  failedLogins Int       @default(0)
  lockedUntil  DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  sessions PlatformAdminSession[]
}

model PlatformAdminSession {
  id        String    @id @default(uuid()) @db.Uuid
  adminId   String    @db.Uuid
  familyId  String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  admin PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId])
  @@index([familyId])
}

// ----------------------------------------------------------------------------
// Configuration and citizens
// ----------------------------------------------------------------------------

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  key       String // stable slug; never reused
  labelAr   String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true) // deactivate, never delete (history keeps its category)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  drafts  ReportDraft[]
  reports Report[]

  @@unique([tenantId, id])
  @@unique([tenantId, key])
  @@index([tenantId, isActive, sortOrder])
}

model Contact {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid
  phoneEnc          Bytes // AES-256-GCM of the E.164 number
  // CHANGED: Item 5 - Blind index HMAC input is `tenantId || ':' || E.164 number` to prevent cross-tenant correlation if the database leaks.
  // Rotation resolution: We retain @@unique([tenantId, phoneHash]) and document an online background re-hash migration.
  // Justification: Including keyVersion in the unique index would permit duplicate contact rows across key rotations, breaking 1:1 identity; re-hashing preserves strict uniqueness.
  phoneHash         String // HMAC-SHA256 blind index (rate limiting, lookup)
  keyVersion        Int       @default(1) // encryption / HMAC key version for rotation
  // CHANGED: Item 4 - Egypt PDPL (Law 151/2020) consent tracking and anonymization
  consentAt         DateTime? @db.Timestamptz(3)
  consentVersion    String?
  anonymizedAt      DateTime? @db.Timestamptz(3)
  chatwootContactId Int?
  optedOutAt        DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  conversations Conversation[]
  reports       Report[]
  notifications Notification[]

  @@unique([tenantId, id])
  @@unique([tenantId, phoneHash])
}

// ----------------------------------------------------------------------------
// Bot workflow
// ----------------------------------------------------------------------------

model Conversation {
  id                     String    @id @default(uuid()) @db.Uuid
  tenantId               String    @db.Uuid
  contactId              String    @db.Uuid
  chatwootConversationId Int
  botState               BotState  @default(IDLE)
  stateVersion           Int       @default(0) // optimistic concurrency, in addition to the lock
  lastInboundAt          DateTime? @db.Timestamptz(3) // input to window-aware sending
  handoffAt              DateTime? @db.Timestamptz(3)
  createdAt              DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @db.Timestamptz(3)

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  contact Contact       @relation(fields: [tenantId, contactId], references: [tenantId, id], onDelete: Restrict)
  drafts  ReportDraft[]

  @@unique([tenantId, id])
  @@unique([tenantId, chatwootConversationId])
  @@index([tenantId, contactId])
}

model ReportDraft {
  id              String      @id @default(uuid()) @db.Uuid
  tenantId        String      @db.Uuid
  conversationId  String      @db.Uuid
  status          DraftStatus @default(ACTIVE)
  categoryId      String?     @db.Uuid
  description     String?     @db.VarChar(1000)
  latitude        Decimal?    @db.Decimal(8, 5)
  longitude       Decimal?    @db.Decimal(8, 5)
  photoSkipped    Boolean     @default(false)
  locationSkipped Boolean     @default(false)
  // Menu snapshot shown to the citizen, so "3" keeps its meaning if categories change mid-draft.
  stepContext     Json        @default("{}")
  expiresAt       DateTime    @db.Timestamptz(3)
  submittedAt     DateTime?   @db.Timestamptz(3)
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @db.Timestamptz(3)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  conversation Conversation @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Restrict)
  // Optional composite FK: if `prisma validate` rejects it, declare the FK in SQL and keep plain columns.
  category     Category?    @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict)
  attachments  Attachment[]
  report       Report?

  @@unique([tenantId, id])
  @@index([tenantId, conversationId])
  // Partial unique index (one ACTIVE draft per conversation) and expiry index: see SQL file, section B2.
}

model Attachment {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String           @db.Uuid
  draftId          String           @db.Uuid
  status           AttachmentStatus @default(PENDING)
  providerMediaRef String? // provider reference; never logged
  objectKey        String? // tenants/{tenantId}/drafts/{draftId}/{id}
  mimeType         String? // detected from bytes, not trusted from the client
  sizeBytes        Int?
  sha256           String?
  failureCode      String?
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  draft  ReportDraft @relation(fields: [tenantId, draftId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, draftId])
}

// ----------------------------------------------------------------------------
// Reports
// ----------------------------------------------------------------------------

model Report {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @db.Uuid
  trackingCode   String // {PREFIX}-{6 chars}; format enforced by CHECK
  draftId        String       @db.Uuid
  contactId      String       @db.Uuid
  categoryId     String       @db.Uuid
  description    String       @db.VarChar(1000)
  latitude       Decimal?     @db.Decimal(8, 5) // citizen-supplied, not verified
  longitude      Decimal?     @db.Decimal(8, 5)
  status         ReportStatus @default(NEW)
  citizenMessage String?      @db.VarChar(500) // citizen-safe text; required when REJECTED (CHECK)
  assignedToId   String?      @db.Uuid
  hasPhoto       Boolean      @default(false) // indexed fast-flag for receptionist table
  hasLocation    Boolean      @default(false)
  version        Int          @default(1) // optimistic concurrency
  resolvedAt     DateTime?    @db.Timestamptz(3) // set iff status = RESOLVED (CHECK)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  draft      ReportDraft   @relation(fields: [tenantId, draftId], references: [tenantId, id], onDelete: Restrict)
  contact    Contact       @relation(fields: [tenantId, contactId], references: [tenantId, id], onDelete: Restrict)
  category   Category      @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict)
  assignedTo User?         @relation(fields: [tenantId, assignedToId], references: [tenantId, id], onDelete: Restrict)
  events     ReportEvent[]

  @@unique([tenantId, id])
  @@unique([tenantId, trackingCode])
  @@unique([tenantId, draftId]) // one report per draft: idempotent submit
  @@index([tenantId, status, createdAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, assignedToId])
  @@index([tenantId, contactId])
}

// Immutable (trigger + revoked UPDATE/DELETE). This is the audit trail for report lifecycle.
model ReportEvent {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @db.Uuid
  reportId    String          @db.Uuid
  type        ReportEventType
  actorType   ActorType
  actorUserId String?         @db.Uuid
  fromStatus  ReportStatus?
  toStatus    ReportStatus?
  visibility  EventVisibility @default(INTERNAL)
  note        String?         @db.VarChar(1000)
  meta        Json? // e.g. ASSIGNED: { fromUserId, toUserId }
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  report        Report         @relation(fields: [tenantId, reportId], references: [tenantId, id], onDelete: Restrict)
  actorUser     User?          @relation(fields: [tenantId, actorUserId], references: [tenantId, id], onDelete: Restrict)
  notifications Notification[]

  @@unique([tenantId, id])
  @@index([tenantId, reportId, createdAt])
}

// ----------------------------------------------------------------------------
// Reliability: outbox and inbox
// ----------------------------------------------------------------------------

// Transactional outbox: created in the same transaction as the event that triggers it.
model Notification {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String             @db.Uuid
  reportEventId     String             @db.Uuid
  contactId         String             @db.Uuid
  type              NotificationType
  status            NotificationStatus @default(PENDING)
  attempts          Int                @default(0)
  nextAttemptAt     DateTime           @default(now()) @db.Timestamptz(3)
  claimedUntil      DateTime?          @db.Timestamptz(3) // worker lease (FOR UPDATE SKIP LOCKED)
  lastErrorCode     String?
  providerMessageId String?
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  sentAt            DateTime?          @db.Timestamptz(3)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  reportEvent ReportEvent @relation(fields: [tenantId, reportEventId], references: [tenantId, id], onDelete: Restrict)
  contact     Contact     @relation(fields: [tenantId, contactId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, reportEventId, type]) // exactly one notification per transition and type
  // Partial index for the poller (status = PENDING): see SQL file, section B2.
}

// Durable webhook inbox: dedup before any side effect.
model InboxMessage {
  id                     String      @id @default(uuid()) @db.Uuid
  tenantId               String      @db.Uuid
  provider               String      @default("chatwoot")
  providerMessageId      String
  chatwootConversationId Int
  // Minimal normalized message (kind, text/coordinates/media ref). Personal data:
  // short retention, never logged.
  normalized             Json
  status                 InboxStatus @default(RECEIVED)
  attempts               Int         @default(0)
  lastErrorCode          String?
  receivedAt             DateTime    @default(now()) @db.Timestamptz(3)
  processedAt            DateTime?   @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, provider, providerMessageId])
  @@index([tenantId, status, receivedAt])
  @@index([tenantId, chatwootConversationId, receivedAt])
}

// ----------------------------------------------------------------------------
// Audit: administrative and platform actions (CC-17). Append-only.
// ----------------------------------------------------------------------------

model AuditEvent {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String?   @db.Uuid // null for platform-level events (the one deliberate exception)
  actorType  ActorType
  actorId    String?   @db.Uuid // polymorphic (User or PlatformAdmin): intentionally no FK
  action     String // e.g. "user.created", "tenant.activated", "failure.replayed"
  targetType String?
  targetId   String?
  meta       Json      @default("{}") // non-sensitive metadata only; never secrets or message content
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([tenantId, action, createdAt])
}
